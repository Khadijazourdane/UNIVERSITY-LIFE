{
  "name": "university-life-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-postgres.js",
    "db:auth-test:setup": "node --env-file=.env scripts/setup-auth-test-db.js",
    "test:auth:postgres": "node --env-file=.env.auth-test --test integration/auth.postgres.js",
    "test": "node --test"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  }
}
