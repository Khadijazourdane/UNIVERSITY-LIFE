# HTTP
HOST=127.0.0.1
PORT=3001

# Origines Flutter Web autorisées, séparées par des virgules
CORS_ORIGINS=

# Auth et HTTPS. Renseigner les deux chemins avec un certificat local approuvé.
AUTH_WEB_ORIGINS=
AUTH_SESSION_TTL_SECONDS=28800
TLS_CERT_FILE=
TLS_KEY_FILE=
# Adresse du proxy de confiance en cas de terminaison TLS hors de Node.
TRUST_PROXY_IP=

# PostgreSQL (laisser les trois identifiants vides pour le mode HTTP seul)
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
